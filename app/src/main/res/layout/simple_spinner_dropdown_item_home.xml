<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    >

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textEidos_Tourtas_Keimeno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Είδος Τούρτας"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvViewEidosTourtas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textEidos_Tourtas_Keimeno"
        android:hint="Επιλέξτε είδος τούρτας"
        app:boxStrokeColor="@color/black"
        android:layout_marginTop="8dp">

        <android.widget.Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/SpEidosTourtas"
            android:entries="@array/String_Eidos_Tourtas"/>
    </com.google.android.material.textfield.TextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
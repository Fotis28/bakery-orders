<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <!-- Header με μήνα -->
    <LinearLayout
        android:id="@+id/YearPeacker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ArrowPreviousMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:icon="@drawable/sharp_arrow_circle_left_24"
            app:iconGravity="end"
            app:tint="?attr/colorOnBackground"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/MonthTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Μήνας"
            android:textAlignment="center"
            android:textSize="24dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ArrowNextMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:icon="@drawable/rounded_arrow_circle_right_24"
            app:tint="?attr/colorOnBackground"
            />
    </LinearLayout>

    <!-- Ημέρες της εβδομάδας -->
    <LinearLayout
        android:id="@+id/weekdaysRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/radioGroupContainer"
        app:layout_constraintTop_toBottomOf="@id/YearPeacker">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MON"
            android:textAlignment="center"
            android:textSize="16dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TUE"
            android:textAlignment="center"
            android:textSize="16dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WED"
            android:textAlignment="center"
            android:textSize="16dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THU"
            android:textAlignment="center"
            android:textSize="16dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FRI"
            android:textAlignment="center"
            android:textSize="16dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAT"
            android:textAlignment="center"
            android:textSize="16dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUN"
            android:textAlignment="center"
            android:textSize="16dp" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/CalendarRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintTop_toBottomOf="@id/weekdaysRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/radioGroupContainer" />

    <android.widget.RadioGroup
        android:id="@+id/radioGroupContainer"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@+id/YearPeacker"
        app:layout_constraintBottom_toBottomOf="@+id/CalendarRecyclerView"
        app:layout_constraintStart_toEndOf="@+id/CalendarRecyclerView"
        app:layout_constraintEnd_toEndOf="parent" >

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioButtonAllShops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Όλα τα μαγαζιά"
            android:checked="true"
            android:textSize="14sp"
            android:layout_marginTop="0dp"/>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioButtonShop1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Συκιές"

            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioButtonShop2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ρετζίκι"

            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioButtonShopInstagram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ευκαρπία"

            android:textSize="14sp"
            android:layout_marginTop="10dp"/>
    </android.widget.RadioGroup>


</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        tools:context=".ui.gallery.CakeOrderFragment">

        <!-- Τίτλος -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_OrderCake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Φόρμα Παραγγελίας Τούρτας"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- Οριζόντια διάταξη: πεδία αριστερά, κουμπί δεξιά -->
        <LinearLayout
            android:id="@+id/main_form_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/text_OrderCake"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"
            android:weightSum="2">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                >
        <!-- Αριστερή στήλη με όλα τα πεδία -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

        <!-- Δηλωση του Στοιχειων του πελατη  -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Onomateponimo_Pelati_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintTop_toBottomOf="@+id/text_OrderCake"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"

            >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/Onomateponimo_Pelati"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:maxLength="20"
                android:digits="ΆΈΉΊΌΎΏΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩΪΫΪΫάέήίόύώϊϋΐΰαβγδεζηθικλμνξοπρσςτυφχψωABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz "

                android:hint="Δώστε το ονοματεπώνυμο του πελάτη"/>

        </com.google.android.material.textfield.TextInputLayout>




        <!-- Δηλωση του Στοιχειων του πελατη  -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Onomateponimo_Pelati_Tilefono_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintTop_toBottomOf="@+id/Onomateponimo_Pelati_layout"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"

            >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/Thilefono_Pelati"
                android:hint="Δώστε το τηλέφωνο του πελάτη"
                android:inputType="phone"
                android:imeOptions="actionDone"
                android:digits="1234567890"
                android:maxLength="10"
                />
        </com.google.android.material.textfield.TextInputLayout>





        <!-- Βαφλα τουρτας-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/RdB_Vafla_Ektiposi_Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/SpinnerGeusis_Toyrtas_Layout">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/TxtEpilogiVaflas"
                android:text="Θέλετε να έχει βάφλα  εκτύπωση?"
                android:textColor="@color/black"
                android:textSize="18dp" />

            <android.widget.Spinner
                android:id="@+id/RdB_Vafla_Ektiposi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:entries="@array/String_Apofasi_Nai_Oxi"


                />
        </com.google.android.material.textfield.TextInputLayout>



        <!--To Μηνυμα που εφμανιζεται αν πατησω ναι στο spinner vaflas-->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/Emailmessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To email οπου ο πελατης θα στειλει την φωτογραφια της εκτυπωσεις orders@sweetbakery.com"
            android:textColor="@color/black"
            android:textSize="18dp"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/RdB_Vafla_Ektiposi_Layout"

            />




        <!-- Σχήμα Τούρτας -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Σχήμα Τούρτας:"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Onomateponimo_Pelati_Tilefono_layout"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutShape"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Επιλέξτε Σχήμα"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            android:layout_marginTop="8dp">

            <android.widget.Spinner
                android:id="@+id/spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/String_tourtas"/>
        </com.google.android.material.textfield.TextInputLayout>


        <!-- Είδος Τουρτας  -->



        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textEidos_Tourtas_Keimeno"
            app:layout_constraintTop_toBottomOf="@+id/textInputLayoutShape"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Είδος Τούρτας"

            android:textSize="18sp"
            android:layout_marginTop="16dp"

            />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvViewEidosTourtas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textEidos_Tourtas_Keimeno"
            android:hint="Επιλέξτε είδος τούρτας"

            android:layout_marginTop="8dp">

            <android.widget.Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/SpEidosTourtas"
                android:entries="@array/String_Eidos_Tourtas"/>
        </com.google.android.material.textfield.TextInputLayout>


        <!--Γευση Τούρτας-->

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Geusi_Tourtas"
            app:layout_constraintTop_toBottomOf="@+id/tvViewEidosTourtas"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Επιλέξτε γεύση τούρτας"
            android:textSize="18dp"

            android:layout_marginTop="16dp"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/SpinnerGeusis_Toyrtas_Layout"
            app:layout_constraintTop_toBottomOf="@+id/Geusi_Tourtas"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"

            >
            <android.widget.Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/SpinnerGeusis_Toyrtas"
                android:entries="@array/String_Epilogi_Geusis_Tourtas"
                />



        </com.google.android.material.textfield.TextInputLayout>



        <!-- Ημερομηνία Παραλαβής -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutDate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ημερομηνία Παραλαβής"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Emailmessage"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/idDateEdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"

                android:textSize="16sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ώρα Παράδοσης -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutTime"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ώρα Παράδοσης"



            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutDate"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/idTimeEdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"

                android:textSize="16sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Κιλά Τούρτας -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutKilosTourtas"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Κιλά Τούρτας"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutTime"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/idEdtNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:textSize="16sp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!--   Σχολια αν χρειαζεται-->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Sxolia_Layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutKilosTourtas"
            android:layout_marginTop="16dp"

            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/idEdtSxolia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="text"
                android:textSize="16sp"

                android:hint="Σχολια για την δημιουργια της τουρτας"/>








        </com.google.android.material.textfield.TextInputLayout>


        </LinearLayout>
            </ScrollView>
        <!-- Κουμπί Ολοκλήρωσης Παραγγελίας -->


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="top|center"
                android:paddingStart="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrder"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:layout_gravity="center"
                    android:text="Ολοκλήρωση Παραγγελίας"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/Sxolia_Layout"
                    />
            </LinearLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>



